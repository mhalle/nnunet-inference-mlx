__pycache__/
*.pyc
.venv/
.venvs/
*.egg-info/
dist/
build/
.pytest_cache/
uv.lock

# Generated data. Untracked deliberately: these are build products of tools/ranked_*.py, they
# are megabytes of binary that would bloat history, and the repo lives in Dropbox - so they are
# backed up without being versioned. Delete and rebuild rather than commit.
data/

# the package manifests are code, not data: the data/ rule above must not swallow them
!src/nnseg/data/
!src/nnseg/data/*.json
